# ====================================================================
# TeleCore AI - Environment Configuration Reference
# ====================================================================

# --------------------------------------------------------------------
# SECRETS (Configure via `wrangler secret put <NAME>` in Cloudflare)
# --------------------------------------------------------------------

# GEMINI_API_KEY [SECRET]: Google Gemini API Key for AI service operations
GEMINI_API_KEY=""

# TELEGRAM_BOT_TOKEN [SECRET]: Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET [SECRET]: Secret token for verifying webhook requests via X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""

# ADMIN_SECRET [SECRET]: Bearer token required for all /api/admin/* management and test endpoints in production
ADMIN_SECRET=""

# --------------------------------------------------------------------
# RUNTIME & CHANNEL CONFIGURATION (Set in Cloudflare Dashboard Variables or wrangler secret put)
# --------------------------------------------------------------------

# TELEGRAM_CHANNEL_ID: Target channel username (e.g. @your_channel) or numeric ID (e.g. -1001234567890)
# (Set in Cloudflare Dashboard > Settings > Variables and Secrets, or `wrangler secret put TELEGRAM_CHANNEL_ID`)
TELEGRAM_CHANNEL_ID=""

# APP_URL: Public HTTPS base URL of deployed worker (e.g. https://telecore-ai.<subdomain>.workers.dev)
# If omitted, TeleCore AI automatically derives the public origin from incoming HTTPS requests
APP_URL=""

# TELEGRAM_TEST_MODE [NON-SECRET]: Defaults to 'true'. When true, blocks all autonomous/scheduled publishing.
# Owner-authorized manual test-publishing via authenticated /api/admin/telegram/test-publish is permitted.
TELEGRAM_TEST_MODE="true"

# ENVIRONMENT [NON-SECRET]: 'development' | 'staging' | 'production' | 'test' (Default: 'development')
ENVIRONMENT="development"

# LOG_LEVEL [NON-SECRET]: 'debug' | 'info' | 'warn' | 'error' (Default: 'info')
LOG_LEVEL="info"

